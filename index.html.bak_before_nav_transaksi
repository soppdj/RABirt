    /* =========================================================
       K. RIWAYAT LAPORAN & KARTU DOWNLOAD ULANG
       ========================================================= */
    function saveToHistoryList(period, data) {
      const history = JSON.parse(localStorage.getItem('rabirt_history_index') || '{}');
      history[period] = {
        ...data,
        updatedAt: new Date().toISOString()
      };
      localStorage.setItem('rabirt_history_index', JSON.stringify(history));
      renderHistoryList();
    }

    async function renderHistoryList() {
      const container = document.getElementById('historyListContainer');
      let historyMap = JSON.parse(localStorage.getItem('rabirt_history_index') || '{}');

      // Tarik juga riwayat dari Supabase jika online
      if (supabaseClient && currentUser && !isGuestMode && navigator.onLine) {
        try {
          const { data } = await supabaseClient
            .from('transactions')
            .select('*')
            .eq('user_id', currentUser.id)
            .order('transaction_date', { ascending: false });

          if (data && data.length > 0) {
            data.forEach(item => {
              if (!historyMap[item.transaction_date]) {
                historyMap[item.transaction_date] = {
                  pemasukan: 0, ziswaf: 0, investasi: 0, pengeluaran: 0,
                  rezeki_tak_terduga: 0, zona_bersyukur: 0
                };
              }
              historyMap[item.transaction_date][item.zone] = Number(item.amount) || 0;
            });
            localStorage.setItem('rabirt_history_index', JSON.stringify(historyMap));
          }
        } catch (e) {}
      }

      const keys = Object.keys(historyMap).sort().reverse();
      if (keys.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            <p>Belum ada riwayat laporan keuangan tersimpan.</p>
          </div>
        `;
        return;
      }

      const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
      
      container.innerHTML = keys.map(period => {
        const item = historyMap[period];
        const [y, m] = period.split('-');
        const monthLabel = monthNames[parseInt(m, 10) - 1] || m;
        return `
          <div class="history-card">
            <div class="history-card-info">
              <h4>Laporan ${monthLabel} ${y}</h4>
              <p>Pengeluaran: Rp ${formatRupiah(item.pengeluaran || 0)}</p>
              <div class="hist-income">Pemasukan: Rp ${formatRupiah(item.pemasukan || 0)}</div>
            </div>
            <button class="btn-download-history" onclick="downloadHistoryPdf('${period}')">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Download PDF
            </button>
          </div>
        `;
      }).join('');
    }

    window.downloadHistoryPdf = function(period) {
      const history = JSON.parse(localStorage.getItem('rabirt_history_index') || '{}');
      if (history[period]) {
        generatePdfReport(history[period], period);
      }
    };

    window.previewHistoryPdf = function(period) {
      const history = JSON.parse(localStorage.getItem('rabirt_history_index') || '{}');
      if (history[period]) {
        openReportPreviewModal(history[period], period);
      }
    };

    /* =========================================================
       L. NAVIGASI BOTTOM BAR & VIEW SWITCHER
       ========================================================= */
    function switchTab(tab) {
      document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.view-container').forEach(el => el.classList.remove('active'));

      const fab = document.getElementById('fabTransaction');
      if (tab === 'utama') {
        document.getElementById('navUtama').classList.add('active');
        document.getElementById('viewDashboard').classList.add('active');
        if (fab) fab.style.display = 'flex';
      } else if (tab === 'riwayat') {
        document.getElementById('navRiwayat').classList.add('active');
        document.getElementById('viewRiwayat').classList.add('active');
        if (fab) fab.style.display = 'none';
        renderHistoryList();
      }
    }

    function showMainApp() {
      document.getElementById('viewLogin').classList.remove('active');
      const navbar = document.querySelector('.app-navbar');
      const bottomNav = document.querySelector('.bottom-nav');
      const fab = document.getElementById('fabTransaction');
      if (navbar) navbar.style.display = 'flex';
      if (bottomNav) bottomNav.style.display = 'flex';
      if (fab) fab.style.display = 'flex';
      const viewport = document.querySelector('.app-viewport');
      if (viewport) {
        viewport.style.paddingBottom = '84px';
        viewport.style.backgroundColor = 'var(--bg-main)';
      }
      switchTab('utama');
      loadUserAvatar();
    }

    function showLoginView() {
      document.querySelectorAll('.view-container').forEach(el => el.classList.remove('active'));
      document.getElementById('viewLogin').classList.add('active');
      const navbar = document.querySelector('.app-navbar');
      const bottomNav = document.querySelector('.bottom-nav');
      const fab = document.getElementById('fabTransaction');
      if (navbar) navbar.style.display = 'none';
      if (bottomNav) bottomNav.style.display = 'none';
      if (fab) fab.style.display = 'none';
      const viewport = document.querySelector('.app-viewport');
      if (viewport) {
        viewport.style.paddingBottom = '0';
        viewport.style.backgroundColor = '#3C7268';
      }
    }

    function openSetupModal() {
      document.getElementById('modalSetup').classList.add('open');
    }

    function closeSetupModal() {
      document.getElementById('modalSetup').classList.remove('open');
    }

    function openConfigModal() {
      document.getElementById('modalConfig').classList.add('open');
    }

    function closeConfigModal() {
      document.getElementById('modalConfig').classList.remove('open');
    }

    /* =========================================================
       M. MODAL PROFIL & FOTO PRIBADI PENGGUNA
       ========================================================= */
    function loadUserAvatar() {
      const savedAvatar = localStorage.getItem('rabirt_user_avatar');
      const navImg = document.getElementById('navUserAvatarImg');
      const navSvg = document.getElementById('navDefaultAvatarSvg');
      const previewImg = document.getElementById('avatarPreviewImg');
      const previewSvg = document.getElementById('avatarPreviewDefaultSvg');
      const btnRemove = document.getElementById('btnRemoveAvatar');

      if (savedAvatar) {
        if (navImg) {
          navImg.src = savedAvatar;
          navImg.style.display = 'block';
        }
        if (navSvg) navSvg.style.display = 'none';
        if (previewImg) {
          previewImg.src = savedAvatar;
          previewImg.style.display = 'block';
        }
        if (previewSvg) previewSvg.style.display = 'none';
        if (btnRemove) btnRemove.style.display = 'inline-block';
      } else {
        if (navImg) {
          navImg.src = '';
          navImg.style.display = 'none';
        }
        if (navSvg) navSvg.style.display = 'block';
        if (previewImg) {
          previewImg.src = '';
          previewImg.style.display = 'none';
        }
        if (previewSvg) previewSvg.style.display = 'block';
        if (btnRemove) btnRemove.style.display = 'none';
      }
    }

    function openProfileModal() {
      const modal = document.getElementById('modalProfile');
      if (!modal) return;
      loadUserAvatar();

      const nameEl = document.getElementById('userDisplayName');
      const nameInput = document.getElementById('profileDisplayNameInput');
      const emailInput = document.getElementById('profileEmailInput');

      if (nameInput && nameEl) {
        nameInput.value = (nameEl.innerText === 'Memuat...' || nameEl.innerText === 'Mode Tamu') ? '' : nameEl.innerText;
      }
      if (emailInput) {
        emailInput.value = (currentUser && currentUser.email) ? currentUser.email : 'tamu@rabirt.local (Mode Tamu)';
      }

      modal.classList.add('open');
    }

    function closeProfileModal() {
      const modal = document.getElementById('modalProfile');
      if (modal) modal.classList.remove('open');
    }

    function handleUserAvatarUpload(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      if (!file.type.startsWith('image/')) {
        showToast("Mohon pilih file gambar (JPG/PNG/WebP).", "error");
        return;
      }

      // Batas ukuran maksimal 5MB
      if (file.size > 5 * 1024 * 1024) {
        showToast("Ukuran foto maksimal 5MB.", "error");
        return;
      }

      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          // Kompresi ringan via canvas agar muat di localStorage tanpa lag
          const canvas = document.createElement('canvas');
          const maxDim = 256;
          let width = img.width;
          let height = img.height;

          if (width > height) {
            if (width > maxDim) {
              height = Math.round((height * maxDim) / width);
              width = maxDim;
            }
          } else {
            if (height > maxDim) {
              width = Math.round((width * maxDim) / height);
              height = maxDim;
            }
          }

          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);

          const compressedBase64 = canvas.toDataURL('image/jpeg', 0.85);
          localStorage.setItem('rabirt_user_avatar', compressedBase64);
          loadUserAvatar();
          showToast("Foto profil berhasil diperbarui! Cantik sekali, Bunda 🌸", "success");
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
      event.target.value = '';
    }

    function removeUserAvatar() {
      if (confirm("Hapus foto profil dan kembali ke avatar standar?")) {
        localStorage.removeItem('rabirt_user_avatar');
        loadUserAvatar();
        showToast("Foto profil telah dihapus.", "info");
      }
    }

    async function saveProfileInfo() {
      const nameInput = document.getElementById('profileDisplayNameInput');
      const newName = nameInput ? nameInput.value.trim() : '';

      if (newName) {
        document.getElementById('userDisplayName').innerText = newName;
        if (supabaseClient && currentUser && !isGuestMode) {
          try {
            await supabaseClient.from('profiles').upsert({
              id: currentUser.id,
              display_name: newName
            });
          } catch (e) {
            console.warn("Gagal simpan nama ke Supabase:", e);
          }
        }
        localStorage.setItem('rabirt_user_name', newName);
      }

      closeProfileModal();
      showToast("Profil Bunda berhasil disimpan!", "success");
    }

    function handleLogoutFromProfile() {
      closeProfileModal();
      const name = document.getElementById('userDisplayName').innerText;
      if (confirm(`Akun: ${name}\nApakah Anda yakin ingin keluar (logout)?`)) {
        if (supabaseClient) supabaseClient.auth.signOut();
        currentUser = null;
        isGuestMode = false;
        showLoginView();
        showToast("Anda telah keluar dari aplikasi.", "info");
      }
    }

    /* =========================================================
       N. REGISTRASI PWA SERVICE WORKER (OFFLINE FIRST)
       ========================================================= */
    function registerPwaServiceWorker() {
      if ('serviceWorker' in navigator) {
        const swCode = `
          const CACHE_NAME = 'rabirt-v2-cache';
          self.addEventListener('install', (e) => {
            self.skipWaiting();
          });
          self.addEventListener('activate', (e) => {
            e.waitUntil(clients.claim());
          });
          self.addEventListener('fetch', (e) => {
            e.respondWith(
              fetch(e.request).catch(() => caches.match(e.request))
            );
          });
        `;
        const blob = new Blob([swCode], { type: 'application/javascript' });
        navigator.serviceWorker.register(URL.createObjectURL(blob))
          .catch(err => console.log('SW Note:', err));
      }
    }

    /* =========================================================
       O. ONLOAD INITIALIZATION
       ========================================================= */
    window.addEventListener('DOMContentLoaded', () => {
      // Inisialisasi avatar pengguna dari cache lokal
      loadUserAvatar();

      // Inisialisasi tanggal dropdown ke bulan & tahun sekarang
      const now = new Date();
      const currentMonth = String(now.getMonth() + 1).padStart(2, '0');
      const currentYear = String(now.getFullYear());
      
      const monthSel = document.getElementById('selectMonth');
      if (monthSel) monthSel.value = currentMonth;
      
      const yearSel = document.getElementById('selectYear');
      if (yearSel) yearSel.value = currentYear;

      // Bind input live Rupiah & Auto Calculation
      const inputPemasukanEl = document.getElementById('inputPemasukan');
      const inputRezekiEl = document.getElementById('inputRezeki');
      const inputBersyukurEl = document.getElementById('inputBersyukur');

      if (inputPemasukanEl) {
        // Saat fokus, jika ada LOP, tampilkan nilai pokok agar mudah diedit tanpa distorsi
        inputPemasukanEl.addEventListener('focus', () => {
          const rezeki = inputRezekiEl ? parseRupiah(inputRezekiEl.value) : 0;
          if (rezeki > 0 && currentMonthData && currentMonthData.base_pemasukan !== undefined) {
            inputPemasukanEl.value = currentMonthData.base_pemasukan > 0 ? formatRupiah(currentMonthData.base_pemasukan) : '';
          }
        });

        bindRupiahInput(inputPemasukanEl, (raw) => {
          if (!currentMonthData) currentMonthData = {};
          currentMonthData.base_pemasukan = raw;
          calculateZones();
        });

        inputPemasukanEl.addEventListener('blur', () => {
          const raw = parseRupiah(inputPemasukanEl.value);
          if (!currentMonthData) currentMonthData = {};
          currentMonthData.base_pemasukan = raw;
          const rezeki = inputRezekiEl ? parseRupiah(inputRezekiEl.value) : 0;
          const total = (currentMonthData.base_pemasukan || 0) + rezeki;
          inputPemasukanEl.value = total > 0 ? formatRupiah(total) : '';
          calculateZones();
          saveCurrentTransaction();
        });
      }

      if (inputRezekiEl) {
        bindRupiahInput(inputRezekiEl, (raw) => {
          if (!currentMonthData) currentMonthData = {};
          currentMonthData.rezeki_tak_terduga = raw;
          const base = currentMonthData.base_pemasukan || 0;
          const total = base + raw;
          if (inputPemasukanEl && document.activeElement !== inputPemasukanEl) {
            inputPemasukanEl.value = total > 0 ? formatRupiah(total) : '';
          }
          calculateZones();
        });
        inputRezekiEl.addEventListener('blur', () => {
          saveCurrentTransaction();
        });
      }

      if (inputBersyukurEl) {
        bindRupiahInput(inputBersyukurEl, (raw) => {
          if (!currentMonthData) currentMonthData = {};
          currentMonthData.zona_bersyukur = raw;
          // Khusus zona bersyukur TIDAK menambah ke zona pemasukan
          calculateZones();
        });
        inputBersyukurEl.addEventListener('blur', () => {
          saveCurrentTransaction();
        });
      }

      // Bind input target modal
      bindRupiahInput(document.getElementById('settingTargetRezeki'));
      bindRupiahInput(document.getElementById('settingTargetBersyukur'));

      // Bind input nominal transaksi modal (Pengeluaran & Pemasukan)
      const expInput = document.getElementById('expenseAmountInput');
      if (expInput) bindRupiahInput(expInput);
      const incInput = document.getElementById('incomeAmountInput');
      if (incInput) bindRupiahInput(incInput);

      // Tutup modal transaksi kas saat user klik backdrop abu-abu di luar sheet
      const modalTrans = document.getElementById('modalTransaction');
      if (modalTrans) {
        modalTrans.addEventListener('click', (e) => {
          if (e.target === modalTrans) {
            closeTransactionModal();
          }
        });
      }

      // Inisialisasi Supabase & Status Online
      initSupabase();
      updateOnlineStatus();
      checkAuthSession();

      // Cek Jam Sedekah Subuh (04:30 - 06:30)
      checkSedekahSubuhTime();

      // Registrasi PWA Service Worker
      registerPwaServiceWorker();
    });
  </script>
