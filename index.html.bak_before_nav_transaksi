      padding: 1.5px 6px;
      border-radius: 4px;
      margin-top: 1px;
    }

    .pdf-zone-pill-status.green { background: #ECFDF5; color: #065F46; border: 0.75px solid #A7F3D0; }
    .pdf-zone-pill-status.blue { background: #EFF6FF; color: #1E40AF; border: 0.75px solid #BFDBFE; }
    .pdf-zone-pill-status.orange { background: #FFFBEB; color: #92400E; border: 0.75px solid #FDE68A; }
    .pdf-zone-pill-status.red { background: #FEF2F2; color: #991B1B; border: 0.75px solid #FECACA; }

    /* Tabel Detail 4 Zona Evaluasi */
    .pdf-table-card {
      background: #FFFFFF;
      border: 1.5px solid #E2E8F0;
      border-radius: 12px;
      padding: 8px 14px 6px;
      margin-bottom: 11px;
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.03);
