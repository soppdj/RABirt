    /* =========================================================
       H. TRANSAKSI BULANAN & AUTO-RESET (PILIH BULAN / TAHUN)
       ========================================================= */
    function getSelectedPeriod() {
      const m = document.getElementById('selectMonth').value;
      const y = document.getElementById('selectYear').value;
      return `${y}-${m}`;
    }

    async function loadPeriodTransactions() {
      const period = getSelectedPeriod();
      
      // Muat daftar pengeluaran harian periode ini
      if (typeof loadPeriodExpenses === 'function') {
        await loadPeriodExpenses(period);
      }

      // Default: Reset form 6 zona menjadi 0 (Auto-reset bulanan)
      document.getElementById('inputPemasukan').value = '';
      document.getElementById('inputZiswaf').value = '0';
      document.getElementById('inputInvestasi').value = '0';
      document.getElementById('inputPengeluaran').value = '0';
      document.getElementById('inputRezeki').value = '';
      document.getElementById('inputBersyukur').value = '';
      calculateZones();

      // Cek apakah ada di localStorage terlebih dahulu
      const localKey = `rabirt_trans_${period}`;
      const localSaved = localStorage.getItem(localKey);
      if (localSaved) {
        try {
          populateFormFromData(JSON.parse(localSaved));
          return;
        } catch (e) {}
      }

      // Tarik dari Supabase tabel 'transactions'
      if (supabaseClient && currentUser && !isGuestMode && navigator.onLine) {
        try {
          const { data, error } = await supabaseClient
            .from('transactions')
            .select('*')
            .eq('user_id', currentUser.id)
            .eq('transaction_date', period);

          if (data && data.length > 0) {
            const mapped = {
              pemasukan: 0,
              ziswaf: 0,
              investasi: 0,
              pengeluaran: 0,
              rezeki_tak_terduga: 0,
              zona_bersyukur: 0
            };
            data.forEach(item => {
              if (mapped.hasOwnProperty(item.zone)) {
                mapped[item.zone] = Number(item.amount) || 0;
              }
            });
            populateFormFromData(mapped);
            localStorage.setItem(localKey, JSON.stringify(mapped));
          }
        } catch (err) {
          console.warn("Gagal menarik transaksi periode:", err);
        }
      }
    }

    function populateFormFromData(data) {
      const rezeki = Number(data.rezeki_tak_terduga) || 0;
      const bersyukur = Number(data.zona_bersyukur) || 0;
      let totalPemasukan = Number(data.pemasukan) || 0;
      let basePemasukan = (data.base_pemasukan !== undefined)
        ? Number(data.base_pemasukan)
        : (totalPemasukan >= rezeki ? totalPemasukan - rezeki : totalPemasukan);

      if (!currentMonthData) currentMonthData = {};
      currentMonthData.base_pemasukan = basePemasukan;
      currentMonthData.rezeki_tak_terduga = rezeki;
      currentMonthData.zona_bersyukur = bersyukur;

      if (document.getElementById('inputRezeki')) document.getElementById('inputRezeki').value = rezeki > 0 ? formatRupiah(rezeki) : '';
      if (document.getElementById('inputBersyukur')) document.getElementById('inputBersyukur').value = bersyukur > 0 ? formatRupiah(bersyukur) : '';
      if (document.getElementById('inputPemasukan')) {
        const displayTotal = basePemasukan + rezeki;
        document.getElementById('inputPemasukan').value = displayTotal > 0 ? formatRupiah(displayTotal) : '';
      }
      calculateZones();
      if (typeof updateModalPoolBalances === 'function') {
        updateModalPoolBalances();
      }
    }

    document.getElementById('selectMonth').addEventListener('change', loadPeriodTransactions);
    document.getElementById('selectYear').addEventListener('change', loadPeriodTransactions);

    /* =========================================================
       I. SIMPAN TRANSAKSI & OFFLINE QUEUE (PWA)
       ========================================================= */
    async function saveCurrentTransaction() {
      if (typeof calculateZones === 'function') {
        calculateZones();
      }
      const period = getSelectedPeriod();
      const payload = [
        { zone: 'pemasukan', amount: currentMonthData.pemasukan, transaction_date: period },
        { zone: 'ziswaf', amount: currentMonthData.ziswaf, transaction_date: period },
        { zone: 'investasi', amount: currentMonthData.investasi, transaction_date: period },
        { zone: 'pengeluaran', amount: currentMonthData.pengeluaran, transaction_date: period },
        { zone: 'rezeki_tak_terduga', amount: currentMonthData.rezeki_tak_terduga, transaction_date: period },
        { zone: 'zona_bersyukur', amount: currentMonthData.zona_bersyukur, transaction_date: period }
      ];

      // Sinkronkan data pengeluaran aktual yang sudah terpakai
      if (typeof getPoolSpent === 'function') {
        currentMonthData.spent_ziswaf = getPoolSpent('ziswaf');
        currentMonthData.spent_investasi = getPoolSpent('investasi');
        currentMonthData.spent_pengeluaran = getPoolSpent('pengeluaran');
      }

      // Simpan ke cache lokal periode ini
      localStorage.setItem(`rabirt_trans_${period}`, JSON.stringify(currentMonthData));

      // Simpan juga ringkasan ke daftar riwayat lokal
      saveToHistoryList(period, currentMonthData);

      // Jika offline, mode tamu, atau belum login: simpan ke antrean lokal
      if (!navigator.onLine || !supabaseClient || isGuestMode || !currentUser) {
        queueOfflineTransactions(payload);
        showToast("Data anggaran berhasil disimpan di perangkat!", "success");
      } else {
        // Online & terotentikasi: kirim langsung ke Supabase
        try {
          const userPayload = payload.map(p => ({
            ...p,
            user_id: currentUser.id
          }));

          // Hapus dulu record lama untuk periode ini agar tidak duplikat
          await supabaseClient
            .from('transactions')
            .delete()
            .eq('user_id', currentUser.id)
            .eq('transaction_date', period);

          const { error } = await supabaseClient
            .from('transactions')
            .insert(userPayload);

          if (error) throw error;
          showToast("Data transaksi berhasil disimpan ke cloud Supabase!", "success");
        } catch (err) {
          console.warn("Gagal menyimpan langsung ke Supabase, masuk antrean:", err);
          queueOfflineTransactions(payload);
          showToast("Gagal terhubung cloud. Data dimasukkan antrean offline.", "warning");
        }
      }
    }

    function queueOfflineTransactions(payloadList) {
      const queue = JSON.parse(localStorage.getItem('rabirt_offline_queue') || '[]');
      queue.push({
        id: 'q_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6),
        timestamp: Date.now(),
        userId: currentUser ? currentUser.id : 'guest',
        data: payloadList
      });
      localStorage.setItem('rabirt_offline_queue', JSON.stringify(queue));
      localStorage.setItem('rabirt_notifications_seen', 'false');
      updateOnlineStatus();
    }

    async function syncOfflineQueue() {
      if (!navigator.onLine || !supabaseClient || isGuestMode || !currentUser) return;
      const queue = JSON.parse(localStorage.getItem('rabirt_offline_queue') || '[]');
      if (queue.length === 0) return;

      showToast(`Menyinkronkan ${queue.length} antrean data offline...`, "info");
      
      const failedItems = [];
      for (const item of queue) {
        try {
          const formatted = item.data.map(d => ({
            ...d,
            user_id: currentUser.id
          }));
          const { error } = await supabaseClient.from('transactions').insert(formatted);
          if (error) failedItems.push(item);
        } catch (e) {
          failedItems.push(item);
        }
      }

      if (failedItems.length === 0) {
        localStorage.removeItem('rabirt_offline_queue');
        localStorage.setItem('rabirt_notifications_seen', 'true');
        showToast("Sinkronisasi latar belakang selesai! Semua data tersimpan di Supabase.", "success");
      } else {
        localStorage.setItem('rabirt_offline_queue', JSON.stringify(failedItems));
      }
      updateOnlineStatus();
    }

