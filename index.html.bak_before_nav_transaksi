        linear-gradient(to top, rgba(226, 232, 240, 0.7) 1px, transparent 1px) 0 0 / 100% 36px,
        linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
      border-radius: 8px 8px 0 0;
