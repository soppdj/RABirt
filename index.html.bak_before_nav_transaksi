    .pdf-bar-3d.target-green .pdf-bar-3d-side { background: #A7F3D0; }
    .pdf-bar-3d.target-green .pdf-bar-val-tag { color: #065F46; }

    .pdf-bar-3d.target-blue .pdf-bar-3d-front { background: #DBEAFE; border: 1px solid #BFDBFE; }
    .pdf-bar-3d.target-blue .pdf-bar-3d-top { background: #EFF6FF; border: 1px solid #BFDBFE; }
    .pdf-bar-3d.target-blue .pdf-bar-3d-side { background: #BFDBFE; }
    .pdf-bar-3d.target-blue .pdf-bar-val-tag { color: #1E40AF; }

    .pdf-bar-3d.target-orange .pdf-bar-3d-front { background: #FEF3C7; border: 1px solid #FDE68A; }
    .pdf-bar-3d.target-orange .pdf-bar-3d-top { background: #FFFBEB; border: 1px solid #FDE68A; }
    .pdf-bar-3d.target-orange .pdf-bar-3d-side { background: #FDE68A; }
    .pdf-bar-3d.target-orange .pdf-bar-val-tag { color: #92400E; }

    .pdf-bar-3d.target-red .pdf-bar-3d-front { background: #FEE2E2; border: 1px solid #FECACA; }
    .pdf-bar-3d.target-red .pdf-bar-3d-top { background: #FEF2F2; border: 1px solid #FECACA; }
    .pdf-bar-3d.target-red .pdf-bar-3d-side { background: #FECACA; }
    .pdf-bar-3d.target-red .pdf-bar-val-tag { color: #991B1B; }

    /* Realisasi Theming (Solid Vibrant 3D) */
    .pdf-bar-3d.realisasi-green .pdf-bar-3d-front { background: linear-gradient(180deg, #34D399, #059669); border: 1px solid #047857; }
    .pdf-bar-3d.realisasi-green .pdf-bar-3d-top { background: #6EE7B7; border: 1px solid #34D399; }
    .pdf-bar-3d.realisasi-green .pdf-bar-3d-side { background: #047857; }
    .pdf-bar-3d.realisasi-green .pdf-bar-val-tag { color: #065F46; }

    .pdf-bar-3d.realisasi-blue .pdf-bar-3d-front { background: linear-gradient(180deg, #60A5FA, #2563EB); border: 1px solid #1D4ED8; }
    .pdf-bar-3d.realisasi-blue .pdf-bar-3d-top { background: #93C5FD; border: 1px solid #60A5FA; }
    .pdf-bar-3d.realisasi-blue .pdf-bar-3d-side { background: #1D4ED8; }
    .pdf-bar-3d.realisasi-blue .pdf-bar-val-tag { color: #1D4ED8; }

    .pdf-bar-3d.realisasi-orange .pdf-bar-3d-front { background: linear-gradient(180deg, #FBBF24, #D97706); border: 1px solid #B45309; }
    .pdf-bar-3d.realisasi-orange .pdf-bar-3d-top { background: #FDE68A; border: 1px solid #FBBF24; }
    .pdf-bar-3d.realisasi-orange .pdf-bar-3d-side { background: #B45309; }
    .pdf-bar-3d.realisasi-orange .pdf-bar-val-tag { color: #B45309; }

    .pdf-bar-3d.realisasi-red .pdf-bar-3d-front { background: linear-gradient(180deg, #F87171, #DC2626); border: 1px solid #B91C1C; }
    .pdf-bar-3d.realisasi-red .pdf-bar-3d-top { background: #FECACA; border: 1px solid #F87171; }
    .pdf-bar-3d.realisasi-red .pdf-bar-3d-side { background: #B91C1C; }
    .pdf-bar-3d.realisasi-red .pdf-bar-val-tag { color: #B91C1C; }

    /* 3D Stage Floor */
    .pdf-3d-floor {
      height: 6px;
