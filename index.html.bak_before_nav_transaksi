    /* Handler Ekspor Dokumen Resmi PDF A4 */
    async function generatePdfReport(targetData = null, targetPeriod = null) {
      const rep = getEvaluationReportData(targetData, targetPeriod);
      const element = document.getElementById('pdfPrintTemplate');
      if (!element) return;

      // Render tampilan laporan ke dalam elemen cetak
      element.innerHTML = renderEvaluationReportHTML(rep);

      element.style.display = 'block';
      element.style.position = 'fixed';
      element.style.left = '0px';
      element.style.top = '0px';
      element.style.width = '794px';
      element.style.minWidth = '794px';
      element.style.maxWidth = '794px';
      element.style.margin = '0px';
      element.style.boxSizing = 'border-box';
      element.style.zIndex = '999999';

      try {
        showToast("Membuat dokumen laporan PDF kualitas tinggi...", "info");

        if (window.html2canvas && (window.jspdf || window.jsPDF)) {
          const canvas = await window.html2canvas(element, {
            scale: 2,
            useCORS: true,
            letterRendering: true,
            backgroundColor: '#ffffff',
            width: 794,
            windowWidth: 794,
            scrollX: 0,
            scrollY: 0,
            x: 0,
            y: 0
          });

          const jsPdfClass = (window.jspdf && window.jspdf.jsPDF) || window.jsPDF;
          const pdf = new jsPdfClass({
            orientation: 'portrait',
            unit: 'mm',
            format: 'a4'
          });

          const pdfWidth = pdf.internal.pageSize.getWidth(); // 210mm
          const pdfHeight = (canvas.height * pdfWidth) / canvas.width;
          const imgData = canvas.toDataURL('image/jpeg', 0.98);

          pdf.addImage(imgData, 'JPEG', 0, 0, pdfWidth, pdfHeight);
          pdf.save(`RABirt_Laporan_Evaluasi_${rep.monthName}_${rep.year}.pdf`);
        } else if (typeof html2pdf === 'function') {
          const opt = {
            margin: 0,
            filename: `RABirt_Laporan_Evaluasi_${rep.monthName}_${rep.year}.pdf`,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: {
              scale: 2,
              useCORS: true,
              letterRendering: true,
              scrollY: 0,
              scrollX: 0,
              width: 794,
              windowWidth: 794
            },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
          };
          await html2pdf().set(opt).from(element).save();
        }

        showToast("Laporan Evaluasi Anggaran PDF berhasil diunduh!", "success");
      } catch (err) {
        console.error("Gagal membuat PDF:", err);
        showToast("Gagal menghasilkan PDF.", "error");
      } finally {
        element.style.display = 'none';
        element.style.position = '';
        element.style.left = '';
        element.style.top = '';
        element.style.width = '';
        element.style.minWidth = '';
        element.style.maxWidth = '';
        element.style.margin = '';
        element.style.boxSizing = '';
        element.style.zIndex = '';
      }
    }

