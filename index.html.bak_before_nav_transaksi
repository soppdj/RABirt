    function deleteNotificationItem(index) {
      const queue = JSON.parse(localStorage.getItem('rabirt_offline_queue') || '[]');
      if (index >= 0 && index < queue.length) {
        queue.splice(index, 1);
        localStorage.setItem('rabirt_offline_queue', JSON.stringify(queue));
        if (queue.length === 0) {
          localStorage.setItem('rabirt_notifications_seen', 'true');
          isNotificationDeleteMode = false;
          const btnMode = document.getElementById('btnToggleDeleteMode');
          const txtMode = document.getElementById('btnToggleDeleteModeText');
