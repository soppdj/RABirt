    /* Peringatan Otomatis Jika Kelebihan Persentase Tiap Zona */
    let zoneWarningDismissed = false;

    function checkZonePercentageLimits(pemasukan, ziswaf, investasi, pengeluaran, sisaTotalKas, sisaZiswaf, sisaInvestasi, sisaPengeluaran) {
      const banner = document.getElementById('zoneWarningBanner');
      const msgEl = document.getElementById('zoneWarningMsg');
      if (!banner || !msgEl) return;

      const cardZiswaf = document.getElementById('cardZiswaf');
      const cardInvestasi = document.getElementById('cardInvestasi');
      const cardPengeluaran = document.getElementById('cardPengeluaran');

      // Reset alert border
      if (cardZiswaf) cardZiswaf.classList.remove('exceeded');
      if (cardInvestasi) cardInvestasi.classList.remove('exceeded');
      if (cardPengeluaran) cardPengeluaran.classList.remove('exceeded');

      if (pemasukan <= 0) {
        banner.style.display = 'none';
        return;
      }

      const ziswafPct = Math.round((ziswaf / pemasukan) * 100);
      const investasiPct = Math.round((investasi / pemasukan) * 100);
      const pengeluaranPct = Math.round((pengeluaran / pemasukan) * 100);
      const totalPct = ziswafPct + investasiPct + pengeluaranPct;

      const warnings = [];

      if (ziswafPct > 50) {
        warnings.push(`Target ZISWAF (${ziswafPct}%) melebihi batas anjuran maksimal 50%.`);
        if (cardZiswaf) cardZiswaf.classList.add('exceeded');
      }

      if (investasiPct > 50) {
        warnings.push(`Target Investasi (${investasiPct}%) melebihi batas anjuran maksimal 50%.`);
        if (cardInvestasi) cardInvestasi.classList.add('exceeded');
      }

      if (pengeluaranPct > 80) {
        warnings.push(`Target Pengeluaran (${pengeluaranPct}%) melebihi batas anjuran maksimal 80%.`);
        if (cardPengeluaran) cardPengeluaran.classList.add('exceeded');
      }

      if (totalPct > 100) {
        warnings.push(`Total alokasi (${totalPct}%) melebihi 100% dari total pemasukan.`);
      }

      // Peringatan overbudget jika sisa dana bernilai minus
      if (typeof sisaPengeluaran === 'number' && sisaPengeluaran < 0) {
        warnings.push(`Pos Pengeluaran overbudget sebesar Rp ${formatRupiah(Math.abs(sisaPengeluaran))}.`);
        if (cardPengeluaran) cardPengeluaran.classList.add('exceeded');
      }

      if (typeof sisaZiswaf === 'number' && sisaZiswaf < 0) {
        warnings.push(`Pos ZISWAF overbudget sebesar Rp ${formatRupiah(Math.abs(sisaZiswaf))}.`);
        if (cardZiswaf) cardZiswaf.classList.add('exceeded');
      }

      if (typeof sisaInvestasi === 'number' && sisaInvestasi < 0) {
        warnings.push(`Pos Investasi overbudget sebesar Rp ${formatRupiah(Math.abs(sisaInvestasi))}.`);
        if (cardInvestasi) cardInvestasi.classList.add('exceeded');
      }

      if (typeof sisaTotalKas === 'number' && sisaTotalKas < 0) {
        warnings.push(`Sisa Total Kas Rumah Tangga mengalami defisit sebesar Rp ${formatRupiah(Math.abs(sisaTotalKas))}. Segera evaluasi pengeluaran.`);
      }

      if (warnings.length > 0 && !zoneWarningDismissed) {
        msgEl.innerHTML = warnings.map(w => `• ${w}`).join('<br>');
        banner.style.display = 'flex';
      } else {
        banner.style.display = 'none';
      }
    }

    function dismissZoneWarning() {
      zoneWarningDismissed = true;
      const banner = document.getElementById('zoneWarningBanner');
      if (banner) banner.style.display = 'none';
    }

