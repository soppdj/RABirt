    .modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(45, 55, 72, 0.45);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 200;
      align-items: flex-end;
      justify-content: center;
    }

    .modal-backdrop.open {
      display: flex;
    }

    .modal-sheet {
      width: 100%;
      max-width: 420px;
      background: #FFFFFF;
      border-radius: 24px 24px 0 0;
      padding: 24px 22px 30px;
      box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.12);
      animation: sheetUp 0.28s ease-out;
      max-height: 90vh;
      overflow-y: auto;
    }

    @keyframes sheetUp {
      from { transform: translateY(100%); }
      to { transform: translateY(0); }
    }

    .sheet-handle {
      width: 42px;
      height: 5px;
      background: #E2E8F0;
      border-radius: 10px;
      margin: 0 auto 18px;
