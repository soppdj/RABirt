    function getDefaultNoteForPool(pool) {
      if (pool === 'pengeluaran') return 'Belanja kebutuhan';
      if (pool === 'ziswaf') return 'Sedekah / Infaq';
      if (pool === 'investasi') return 'Investasi / Tabungan';
      return 'Pengeluaran harian';
    }

    function getPoolLabel(pool) {
      if (pool === 'pengeluaran') return 'Pengeluaran';
      if (pool === 'ziswaf') return 'Ziswaf';
      if (pool === 'investasi') return 'Investasi';
      return pool;
    }

    function saveCurrentMonthExpensesLocally(period) {
      localStorage.setItem(`rabirt_expenses_${period}`, JSON.stringify(currentMonthExpenses));
    }

    async function loadPeriodExpenses(period) {
      currentMonthExpenses = [];
      const localKey = `rabirt_expenses_${period}`;
      const localSaved = localStorage.getItem(localKey);
      if (localSaved) {
        try {
          currentMonthExpenses = JSON.parse(localSaved);
        } catch (e) {
          currentMonthExpenses = [];
        }
      }

      // Jika terhubung ke Supabase dan online, coba ambil data terbaru
      if (supabaseClient && currentUser && !isGuestMode && navigator.onLine) {
        try {
          const { data, error } = await supabaseClient
            .from('daily_expenses')
            .select('*')
            .eq('user_id', currentUser.id)
            .eq('period', period)
            .order('expense_date', { ascending: false });

          if (data && data.length > 0) {
            currentMonthExpenses = data;
            saveCurrentMonthExpensesLocally(period);
          }
        } catch (err) {
          // Table may not exist yet or offline, local cache is preserved safely
          console.warn("Supabase daily_expenses sync info:", err);
        }
      }

      calculateZones();
      updateModalPoolBalances();
      renderDailyExpensesList();
    }

    async function submitDailyExpense() {
      const amountInput = document.getElementById('expenseAmountInput');
      const noteInput = document.getElementById('expenseNoteInput');
      const dateInput = document.getElementById('expenseDateInput');

      const amount = parseRupiah(amountInput.value);
      if (amount <= 0) {
        showToast("Harap masukkan nominal pengeluaran yang valid!", "warning");
        if (amountInput) amountInput.focus();
        return;
      }

      const period = getSelectedPeriod();
      const expenseDate = dateInput.value || new Date().toISOString().split('T')[0];
      const note = (noteInput && noteInput.value.trim()) ? noteInput.value.trim() : getDefaultNoteForPool(selectedExpensePool);

      const newExpense = {
        id: 'exp_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7),
        pool: selectedExpensePool,
        amount: amount,
        note: note,
        expense_date: expenseDate,
        period: period,
        created_at: new Date().toISOString()
      };

      currentMonthExpenses.unshift(newExpense);
      saveCurrentMonthExpensesLocally(period);

      // Kirim ke Supabase jika aktif
      if (supabaseClient && currentUser && !isGuestMode && navigator.onLine) {
        try {
          await supabaseClient.from('daily_expenses').insert([{
            user_id: currentUser.id,
            pool: newExpense.pool,
            amount: newExpense.amount,
            note: newExpense.note,
            expense_date: newExpense.expense_date,
            period: newExpense.period
          }]);
        } catch (err) {
          console.warn("Supabase insert daily_expenses failed/skipped:", err);
        }
      }

      // Reset form & tutup modal
      amountInput.value = '';
      if (noteInput) noteInput.value = '';
      closeTransactionModal();

      // Update tampilan & toast
      calculateZones();
      updateModalPoolBalances();
      renderDailyExpensesList();
      showToast(`Pengeluaran Rp ${formatRupiah(amount)} (${getPoolLabel(selectedExpensePool)}) berhasil dicatat!`, "success");
    }

