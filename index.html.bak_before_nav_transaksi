    /* =========================================================
       F. AUTO-CALCULATE 6 ZONA & KELEBIHAN SALDO
       ========================================================= */
    function calculateZones() {
      const inputPemasukanEl = document.getElementById('inputPemasukan');
      const inputRezekiEl = document.getElementById('inputRezeki');
      const inputBersyukurEl = document.getElementById('inputBersyukur');

      const rezeki = inputRezekiEl ? parseRupiah(inputRezekiEl.value) : 0;
      const bersyukur = inputBersyukurEl ? parseRupiah(inputBersyukurEl.value) : 0;

      // Inisialisasi base_pemasukan (gaji pokok / rutin sebelum LOP) jika belum diset
      if (!currentMonthData || currentMonthData.base_pemasukan === undefined) {
        const curP = inputPemasukanEl ? parseRupiah(inputPemasukanEl.value) : 0;
        if (!currentMonthData) currentMonthData = {};
        currentMonthData.base_pemasukan = curP >= rezeki ? curP - rezeki : curP;
      }

      // Sesuai Perintah Spesifik User:
      // 1. "Ketika user mengisi zona [Rezeki Tak Terduga] ini, maka akan bertambah ke zona pemasukan."
      // 2. "Khusus Zona Bersyukur, nominalnya tidak perlu ditambahkan ke kolom zona pemasukan."
      const totalPemasukan = (currentMonthData.base_pemasukan || 0) + rezeki;
      const pemasukan = totalPemasukan;

      // Update tampilan nilai di input Zona Pemasukan jika pengguna tidak sedang fokus mengetik
      if (inputPemasukanEl && document.activeElement !== inputPemasukanEl) {
        inputPemasukanEl.value = totalPemasukan > 0 ? formatRupiah(totalPemasukan) : '';
      }

      // Update Subtext Informasi di Bawah Input Pemasukan
      const subtextPemasukanEl = document.getElementById('subtextPemasukan');
      if (subtextPemasukanEl) {
        if (rezeki > 0 && currentMonthData.base_pemasukan > 0) {
          subtextPemasukanEl.innerHTML = `+ LOP Rp ${formatRupiah(rezeki)} <span style="opacity:0.85;">(Pokok Rp ${formatRupiah(currentMonthData.base_pemasukan)})</span>`;
        } else if (rezeki > 0) {
          subtextPemasukanEl.innerHTML = `<span style="color:#10B981;font-weight:700;">Termasuk LOP Rp ${formatRupiah(rezeki)}</span>`;
        } else {
          subtextPemasukanEl.innerText = 'Basis Anggaran Kas';
        }
      }

      // Hitung alokasi dasar 3 kolam berdasarkan persentase template dari total pemasukan
      const ziswafAlokasi = Math.round(pemasukan * (userSettings.ziswaf_pct / 100));
      const investasiAlokasi = Math.round(pemasukan * (userSettings.investasi_pct / 100));
      const pengeluaranAlokasi = Math.round(pemasukan * (userSettings.pengeluaran_pct / 100));

      // Hitung akumulasi pengeluaran yang telah dicatat untuk masing-masing kolam
      const spentZiswaf = typeof getPoolSpent === 'function' ? getPoolSpent('ziswaf') : 0;
      const spentInvestasi = typeof getPoolSpent === 'function' ? getPoolSpent('investasi') : 0;
      const spentPengeluaran = typeof getPoolSpent === 'function' ? getPoolSpent('pengeluaran') : 0;
      const totalSpentAll = spentZiswaf + spentInvestasi + spentPengeluaran;

      // Hitung Sisa Dana di masing-masing kolam (Alokasi - Terpakai)
      const sisaZiswaf = ziswafAlokasi - spentZiswaf;
      const sisaInvestasi = investasiAlokasi - spentInvestasi;
      const sisaPengeluaran = pengeluaranAlokasi - spentPengeluaran;

      // Update Tampilan Nilai Sisa di Kolam ZISWAF
      const inputZ = document.getElementById('inputZiswaf');
      if (inputZ) {
        inputZ.value = (sisaZiswaf < 0 ? '- ' : '') + formatRupiah(Math.abs(sisaZiswaf));
        inputZ.style.color = sisaZiswaf < 0 ? '#E52246' : 'var(--text-main)';
      }
      const spentZTxt = document.getElementById('subtextSpentZiswaf');
      if (spentZTxt) spentZTxt.innerText = `Terpakai: Rp ${formatRupiah(spentZiswaf)}`;
      const pctZTxt = document.getElementById('subtextPctZiswaf');
      if (pctZTxt) {
        const pctZ = pemasukan > 0 ? Math.round((sisaZiswaf / pemasukan) * 100) : 0;
        pctZTxt.innerText = `(${pctZ}%)`;
      }

      // Update Tampilan Nilai Sisa di Kolam Investasi
      const inputI = document.getElementById('inputInvestasi');
      if (inputI) {
        inputI.value = (sisaInvestasi < 0 ? '- ' : '') + formatRupiah(Math.abs(sisaInvestasi));
        inputI.style.color = sisaInvestasi < 0 ? '#E52246' : 'var(--text-main)';
      }
      const spentITxt = document.getElementById('subtextSpentInvestasi');
      if (spentITxt) spentITxt.innerText = `Terpakai: Rp ${formatRupiah(spentInvestasi)}`;
      const pctITxt = document.getElementById('subtextPctInvestasi');
      if (pctITxt) {
        const pctI = pemasukan > 0 ? Math.round((sisaInvestasi / pemasukan) * 100) : 0;
        pctITxt.innerText = `(${pctI}%)`;
      }

      // Update Tampilan Nilai Sisa di Kolam Pengeluaran
      const inputP = document.getElementById('inputPengeluaran');
      if (inputP) {
        inputP.value = (sisaPengeluaran < 0 ? '- ' : '') + formatRupiah(Math.abs(sisaPengeluaran));
        inputP.style.color = sisaPengeluaran < 0 ? '#E52246' : 'var(--text-main)';
      }
      const spentPTxt = document.getElementById('subtextSpentPengeluaran');
      if (spentPTxt) spentPTxt.innerText = `Terpakai: Rp ${formatRupiah(spentPengeluaran)}`;
      const pctPTxt = document.getElementById('subtextPctPengeluaran');
      if (pctPTxt) {
        const pctP = pemasukan > 0 ? Math.round((sisaPengeluaran / pemasukan) * 100) : 0;
        pctPTxt.innerText = `(${pctP}%)`;
      }

      // SISA TOTAL KAS RUMAH TANGGA: Total Pemasukan - Total Terpakai Seluruh Kolam
      // Sesuai Gambar 2 & instruksi: semakin banyak pencatatan harian, dana semakin berkurang
      const sisaTotalKas = pemasukan - totalSpentAll;
      const saldoEl = document.getElementById('valKelebihanSaldo');
      if (saldoEl) {
        saldoEl.innerText = (sisaTotalKas < 0 ? '- ' : '') + formatRupiah(Math.abs(sisaTotalKas));
        if (sisaTotalKas < 0) {
          saldoEl.style.color = 'var(--pastel-red)';
        } else {
          saldoEl.style.color = '#FFFFFF';
        }
      }

      const heroIncomeEl = document.getElementById('heroTotalPemasukan');
      if (heroIncomeEl) {
        heroIncomeEl.innerText = 'Rp ' + formatRupiah(pemasukan);
      }

      // Update state data saat ini
      currentMonthData = {
        pemasukan,
        base_pemasukan: currentMonthData.base_pemasukan || 0,
        ziswaf: ziswafAlokasi,
        investasi: investasiAlokasi,
        pengeluaran: pengeluaranAlokasi,
        spent_ziswaf: spentZiswaf,
        spent_investasi: spentInvestasi,
        spent_pengeluaran: spentPengeluaran,
        sisa_ziswaf: sisaZiswaf,
        sisa_investasi: sisaInvestasi,
        sisa_pengeluaran: sisaPengeluaran,
        total_spent: totalSpentAll,
        rezeki_tak_terduga: rezeki,
        zona_bersyukur: bersyukur,
        kelebihan_saldo: sisaTotalKas
      };

      // Cek dan tampilkan notifikasi peringatan jika ada overbudget atau persentase melebihi batas
      checkZonePercentageLimits(pemasukan, ziswafAlokasi, investasiAlokasi, pengeluaranAlokasi, sisaTotalKas, sisaZiswaf, sisaInvestasi, sisaPengeluaran);

      // Update saldo sisa kolam transaksi kas di modal
      if (typeof updateModalPoolBalances === 'function') {
        updateModalPoolBalances();
      }
    }

