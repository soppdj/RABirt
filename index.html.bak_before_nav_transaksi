    .pdf-zone-col-3d {
      width: 125px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      height: 100%;
      position: relative;
    }

    .pdf-bars-pair {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 8px;
      width: 100%;
      height: 145px;
      position: relative;
    }

    /* 3D Isometric Column Elements */
    .pdf-bar-3d {
      width: 22px;
      position: relative;
    }

    .pdf-bar-3d-front {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 22px;
      height: 100%;
      border-radius: 2px 2px 0 0;
    }

    .pdf-bar-3d-top {
      position: absolute;
      top: -5px;
      left: 3px;
      width: 22px;
      height: 5px;
      transform: skewX(-45deg);
      border-radius: 2px 2px 0 0;
    }

    .pdf-bar-3d-side {
      position: absolute;
      top: -2.5px;
      right: -5px;
      width: 5px;
      height: 100%;
      transform: skewY(-45deg);
      border-radius: 0 2px 2px 0;
    }

    .pdf-bar-3d-gloss {
      position: absolute;
      top: 2px;
      left: 2px;
      width: 3px;
      height: calc(100% - 4px);
      background: rgba(255, 255, 255, 0.45);
      border-radius: 1.5px;
    }

    .pdf-bar-val-tag {
      position: absolute;
      top: -20px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 8.5px;
      font-weight: 800;
      white-space: nowrap;
      text-align: center;
