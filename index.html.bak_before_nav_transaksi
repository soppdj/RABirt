    .pdf-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 10px;
    }

    .pdf-table th {
      padding: 5px 6px;
      font-weight: 800;
      color: #475569;
      text-transform: capitalize;
      border-bottom: 1.5px solid #E2E8F0;
    }

    .pdf-table td {
      padding: 5px 6px;
      color: #334155;
      font-weight: 600;
      border-bottom: 1px solid #F1F5F9;
    }

    .pdf-table tr:last-child td {
      border-bottom: none;
    }

    .pdf-pos-name {
      font-weight: 800;
      display: inline-flex;
      align-items: center;
    }

    .pdf-pos-name.pemasukan { color: #047857; }
    .pdf-pos-name.ziswaf { color: #1D4ED8; }
    .pdf-pos-name.investasi { color: #B45309; }
    .pdf-pos-name.pengeluaran { color: #B91C1C; }

    .pdf-zone-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      margin-right: 5px;
    }

    .pdf-zone-dot.green { background: #10B981; }
    .pdf-zone-dot.blue { background: #3B82F6; }
    .pdf-zone-dot.orange { background: #F59E0B; }
    .pdf-zone-dot.red { background: #EF4444; }

    .pdf-tag-kas {
      font-size: 8px;
      padding: 1px 4px;
      border-radius: 3px;
      background: #ECFDF5;
      color: #065F46;
      font-weight: 800;
      margin-left: 4px;
      border: 0.5px solid #A7F3D0;
    }

    .pdf-afirmasi-tag {
      display: inline-block;
      font-size: 8px;
      font-weight: 800;
      padding: 2px 6px;
      border-radius: 4px;
      white-space: nowrap;
      letter-spacing: 0.2px;
    }
    .pdf-afirmasi-tag.green { background: #ECFDF5; color: #065F46; border: 0.75px solid #A7F3D0; }
    .pdf-afirmasi-tag.blue { background: #EFF6FF; color: #1E40AF; border: 0.75px solid #BFDBFE; }
    .pdf-afirmasi-tag.orange { background: #FFFBEB; color: #92400E; border: 0.75px solid #FDE68A; }
    .pdf-afirmasi-tag.red { background: #FEF2F2; color: #991B1B; border: 0.75px solid #FECACA; }

    /* Kotak Kesimpulan Analisis Cerdas ala Ibu Rumah Tangguh */
    .pdf-analysis-section {
      margin-bottom: 12px;
    }

    .pdf-analysis-header {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11.5px;
      font-weight: 800;
      color: #1E293B;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
    }

    .pdf-analysis-box {
      background: #FFFDF5;
      border: 1.5px solid #FCD34D;
      border-radius: 12px;
      padding: 10px 14px;
    }

    .pdf-analysis-top {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }

    .pdf-analysis-badge {
      font-size: 10px;
      font-weight: 800;
      padding: 2.5px 8px;
      border-radius: 5px;
      color: #FFFFFF;
      background: #059669;
      letter-spacing: 0.3px;
      display: inline-block;
    }

    .pdf-analysis-headline {
      font-size: 12px;
      font-weight: 800;
      color: #78350F;
    }

    .pdf-analysis-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .pdf-analysis-item {
      display: flex;
      align-items: flex-start;
      gap: 6px;
      font-size: 10.5px;
      color: #92400E;
      line-height: 1.4;
    }

    .pdf-analysis-bullet {
      color: #D97706;
      font-size: 12px;
      line-height: 1;
      margin-top: 1px;
    }

    /* Footer Dokumen PDF */
    .pdf-footer-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid #E2E8F0;
      padding-top: 8px;
