    /* =========================================================
       G. SUPABASE BACKEND / AUTH / SETTINGS
       ========================================================= */
    async function checkAuthSession() {
      if (supabaseClient) {
        try {
          const { data: { session }, error } = await supabaseClient.auth.getSession();
          if (session && session.user) {
            currentUser = session.user;
            isGuestMode = false;
            loadUserProfileAndSettings();
            showMainApp();
            return;
          }
        } catch (e) {
          console.warn("Session check error:", e);
        }
      }

      // Default: Tampilkan Halaman Login sesuai desain mockup
      showLoginView();
    }

    async function handleAuthSubmit() {
      const email = document.getElementById('authEmail').value.trim();
      const password = document.getElementById('authPassword').value;
      const displayName = document.getElementById('authDisplayName').value.trim();
      const btn = document.getElementById('btnAuthSubmit');
      btn.disabled = true;
      btn.innerText = "Memproses...";

      try {
        if (!supabaseClient) {
          throw new Error("Koneksi Supabase belum terkonfigurasi. Gunakan mode tamu.");
        }

        if (authMode === 'login') {
          const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
          if (error) throw error;
          currentUser = data.user;
          showToast("Berhasil masuk! Selamat datang kembali.", "success");
          await loadUserProfileAndSettings();
          showMainApp();
        } else {
          // Signup Mode
          const { data, error } = await supabaseClient.auth.signUp({ 
            email, 
            password,
            options: {
              data: { display_name: displayName || 'Ibu Rumah Tangguh' }
            }
          });
          if (error) throw error;
          currentUser = data.user;
          
          // Simpan profile ke tabel 'profiles'
          if (currentUser) {
            await supabaseClient.from('profiles').upsert({
              id: currentUser.id,
              display_name: displayName || email.split('@')[0]
            });
          }
          showToast("Pendaftaran berhasil!", "success");
          openSetupModal(); // Pop-up pengaturan awal pertama kali
          showMainApp();
        }
      } catch (err) {
        showToast(err.message || "Autentikasi gagal.", "error");
      } finally {
        btn.disabled = false;
        btn.innerText = authMode === 'login' ? "Masuk" : "Daftar Sekarang";
      }
    }

    function toggleAuthMode() {
      authMode = authMode === 'login' ? 'signup' : 'login';
      const submitBtn = document.getElementById('btnAuthSubmit');
      const toggleBtn = document.getElementById('btnToggleAuthMode');
      const groupName = document.getElementById('groupDisplayName');
      const forgotLink = document.getElementById('linkForgotPassword');

      if (authMode === 'signup') {
        if (submitBtn) submitBtn.innerText = "Daftar Sekarang";
        if (toggleBtn) toggleBtn.innerText = "Sudah punya akun? Masuk";
        if (groupName) groupName.style.display = "flex";
        if (forgotLink) forgotLink.style.display = "none";
      } else {
        if (submitBtn) submitBtn.innerText = "Masuk";
        if (toggleBtn) toggleBtn.innerText = "Daftar dulu";
        if (groupName) groupName.style.display = "none";
        if (forgotLink) forgotLink.style.display = "inline-block";
      }
    }

    async function handleForgotPassword() {
      const email = document.getElementById('authEmail').value.trim();
      if (!email) {
        showToast("Ketik email Anda di kolom email terlebih dahulu.", "info");
        const emailInput = document.getElementById('authEmail');
        if (emailInput) emailInput.focus();
        return;
      }

      if (!supabaseClient) {
        showToast("Layanan Supabase belum terhubung untuk reset password.", "warning");
        return;
      }

      try {
        const { error } = await supabaseClient.auth.resetPasswordForEmail(email);
        if (error) throw error;
        showToast("Instruksi reset password telah dikirim ke email Anda.", "success");
      } catch (err) {
        showToast(err.message || "Gagal mengirim link reset password.", "error");
      }
    }

    function enableGuestMode() {
      isGuestMode = true;
      currentUser = { id: 'guest-user', email: 'tamu@rabirt.local' };
      document.getElementById('userDisplayName').innerText = "Mode Tamu";
      loadLocalSettings();
      showMainApp();
