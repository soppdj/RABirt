      font-size: 18px;
      font-weight: 800;
      color: var(--text-main);
    }

    .sheet-subtitle {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .btn-close-modal {
      background: #EDF2F7;
      border: none;
