    async function deleteDailyExpense(id) {
      const itemIndex = currentMonthExpenses.findIndex(e => e.id === id);
      if (itemIndex === -1) return;

      const item = currentMonthExpenses[itemIndex];

      // Kembalikan efek nilai transaksi jika berupa pemasukan / rezeki / bersyukur
      if (item.type === 'income' || item.pool === 'rezeki_tak_terduga' || item.pool === 'zona_bersyukur' || item.pool === 'pemasukan') {
        if (item.pool === 'rezeki_tak_terduga' || item.category === 'rezeki') {
          const inputRezekiEl = document.getElementById('inputRezeki');
          const curRezeki = inputRezekiEl ? parseRupiah(inputRezekiEl.value) : 0;
          const newRezeki = Math.max(0, curRezeki - (Number(item.amount) || 0));
          if (inputRezekiEl) inputRezekiEl.value = newRezeki > 0 ? formatRupiah(newRezeki) : '';
          currentMonthData.rezeki_tak_terduga = newRezeki;

          // Revert juga dari Zona Pemasukan
          const base = currentMonthData.base_pemasukan || 0;
          const total = base + newRezeki;
          const inputPemasukanEl = document.getElementById('inputPemasukan');
          if (inputPemasukanEl) inputPemasukanEl.value = total > 0 ? formatRupiah(total) : '';
        } else if (item.pool === 'zona_bersyukur' || item.category === 'bersyukur') {
          const inputBersyukurEl = document.getElementById('inputBersyukur');
          const curBersyukur = inputBersyukurEl ? parseRupiah(inputBersyukurEl.value) : 0;
          const newBersyukur = Math.max(0, curBersyukur - (Number(item.amount) || 0));
          if (inputBersyukurEl) inputBersyukurEl.value = newBersyukur > 0 ? formatRupiah(newBersyukur) : '';
          currentMonthData.zona_bersyukur = newBersyukur;
          // Pemasukan TIDAK tersentuh
        } else {
          // Pemasukan Pokok
          const curBase = currentMonthData.base_pemasukan || 0;
          const newBase = Math.max(0, curBase - (Number(item.amount) || 0));
          currentMonthData.base_pemasukan = newBase;
          const rezeki = currentMonthData.rezeki_tak_terduga || 0;
          const total = newBase + rezeki;
          const inputPemasukanEl = document.getElementById('inputPemasukan');
          if (inputPemasukanEl) inputPemasukanEl.value = total > 0 ? formatRupiah(total) : '';
        }
      }

      currentMonthExpenses.splice(itemIndex, 1);
      const period = getSelectedPeriod();
      saveCurrentMonthExpensesLocally(period);

      if (supabaseClient && currentUser && !isGuestMode && navigator.onLine) {
        try {
          await supabaseClient.from('daily_expenses').delete().eq('id', id);
        } catch (err) {
          console.warn("Supabase delete daily_expenses failed/skipped:", err);
        }
      }

      calculateZones();
      await saveCurrentTransaction();
      updateModalPoolBalances();
      renderDailyExpensesList();
      showToast("Catatan transaksi berhasil dihapus.", "info");
    }

    function renderDailyExpensesList() {
      const container = document.getElementById('dailyExpensesList');
      const subtitle = document.getElementById('dailyExpensesSubtitle');
      const period = getSelectedPeriod();
      const [year, month] = period.split('-');
      const monthNames = ['', 'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];

      if (subtitle) {
        subtitle.innerText = `Pencatatan kas harian bulan ${monthNames[parseInt(month, 10)] || month} ${year}`;
      }

      if (!container) return;

      if (!currentMonthExpenses || currentMonthExpenses.length === 0) {
        container.innerHTML = `
          <div class="empty-expense-hint">
            <p>Belum ada pengeluaran harian yang dicatat bulan ini.</p>
            <button type="button" class="btn-add-expense-chip" style="margin-top: 8px;" onclick="openTransactionModal('pengeluaran')">
              + Catat Pengeluaran Sekarang
            </button>
          </div>
        `;
        return;
      }

      let html = '';
      currentMonthExpenses.forEach(item => {
        let badgeClass = 'badge-pengeluaran';
        let poolLabel = 'Pengeluaran';
        let amountClass = 'expense-amount';
        let amountSign = '- ';

        if (item.type === 'income' || ['pemasukan', 'rezeki_tak_terduga', 'zona_bersyukur'].includes(item.pool)) {
          amountSign = '+ ';
          if (item.pool === 'rezeki_tak_terduga' || item.category === 'rezeki') {
            badgeClass = 'badge-rezeki';
            poolLabel = '✨ Rezeki (LOP)';
            amountClass = 'income-amount';
          } else if (item.pool === 'zona_bersyukur' || item.category === 'bersyukur') {
            badgeClass = 'badge-bersyukur';
            poolLabel = '🌱 Mari Syukuri';
            amountClass = 'syukur-amount';
          } else {
            badgeClass = 'badge-pemasukan';
            poolLabel = '↓ Pemasukan';
            amountClass = 'income-amount';
          }
        } else {
          amountSign = '- ';
          amountClass = 'expense-amount';
          if (item.pool === 'ziswaf') {
            badgeClass = 'badge-ziswaf';
            poolLabel = 'Ziswaf';
          } else if (item.pool === 'investasi') {
            badgeClass = 'badge-investasi';
            poolLabel = 'Investasi';
          } else {
            badgeClass = 'badge-pengeluaran';
            poolLabel = 'Pengeluaran';
          }
        }

        // Format tanggal display (contoh: 12 Sep 2026)
        let formattedDate = item.expense_date || '';
        try {
          const parts = item.expense_date.split('-');
          if (parts.length === 3) {
            const shortMonths = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Ags', 'Sep', 'Okt', 'Nov', 'Des'];
            formattedDate = `${parseInt(parts[2], 10)} ${shortMonths[parseInt(parts[1], 10)]} ${parts[0]}`;
          }
        } catch (e) {}

        const safeNote = (item.note || 'Transaksi Kas')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');

        html += `
          <div class="expense-item-row">
            <div class="expense-item-left">
              <span class="expense-pool-badge ${badgeClass}">${poolLabel}</span>
              <div class="expense-item-details">
                <div class="expense-item-note">${safeNote}</div>
                <div class="expense-item-date">${formattedDate}</div>
              </div>
            </div>
            <div class="expense-item-right">
              <span class="expense-item-amount ${amountClass}">${amountSign}Rp ${formatRupiah(item.amount)}</span>
              <button type="button" class="btn-delete-expense" title="Hapus catatan" onclick="deleteDailyExpense('${item.id}')">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"/>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                </svg>
              </button>
            </div>
          </div>
        `;
      });

      container.innerHTML = html;
    }

