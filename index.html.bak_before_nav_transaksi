    async function loadUserProfileAndSettings() {
      if (isGuestMode || !currentUser) {
        loadLocalSettings();
        return;
      }

      try {
        // 1. Ambil profile dari 'profiles'
        const { data: profile } = await supabaseClient
          .from('profiles')
          .select('display_name')
          .eq('id', currentUser.id)
          .single();
        
        const name = (profile && profile.display_name) || currentUser.email.split('@')[0];
        document.getElementById('userDisplayName').innerText = name;

        // 2. Ambil user_settings
        const { data: settings, error } = await supabaseClient
          .from('user_settings')
          .select('*')
          .eq('user_id', currentUser.id)
          .single();

        if (settings) {
          userSettings = {
            ziswaf_pct: Number(settings.ziswaf_pct) || 20,
            investasi_pct: Number(settings.investasi_pct) || 30,
            pengeluaran_pct: Number(settings.pengeluaran_pct) || 50,
            target_rezeki_tak_terduga: Number(settings.target_rezeki_tak_terduga) || 1000000,
            target_zona_bersyukur: Number(settings.target_zona_bersyukur) || 500000
          };
          saveLocalSettings();
        } else {
          // User baru pertama kali masuk -> Munculkan pop-up modal "Pengaturan Awal"
          openSetupModal();
        }
      } catch (err) {
        console.warn("Gagal mengambil settings cloud, menggunakan cache lokal:", err);
        loadLocalSettings();
      }

      renderCardTemplateBadges();
      loadPeriodTransactions();
    }

    async function saveUserSettings() {
      const ziswaf = parseInt(document.getElementById('settingZiswafPct').value, 10) || 0;
      const investasi = parseInt(document.getElementById('settingInvestasiPct').value, 10) || 0;
      const pengeluaran = parseInt(document.getElementById('settingPengeluaranPct').value, 10) || 0;
      const rezeki = parseRupiah(document.getElementById('settingTargetRezeki').value);
      const bersyukur = parseRupiah(document.getElementById('settingTargetBersyukur').value);

      if (ziswaf > 50) return showToast("ZISWAF maksimal 50%!", "warning");
      if (investasi > 50) return showToast("Investasi maksimal 50%!", "warning");
      if (pengeluaran > 80) return showToast("Pengeluaran maksimal 80%!", "warning");
      if (ziswaf + investasi + pengeluaran > 100) {
        document.getElementById('pctWarning').style.display = 'block';
        return showToast("Total persentase melebihi 100%!", "warning");
      }
      document.getElementById('pctWarning').style.display = 'none';

      userSettings = {
        ziswaf_pct: ziswaf,
        investasi_pct: investasi,
        pengeluaran_pct: pengeluaran,
        target_rezeki_tak_terduga: rezeki,
        target_zona_bersyukur: bersyukur
      };

      saveLocalSettings();
      renderCardTemplateBadges();
      calculateZones();

      // Simpan ke Supabase jika terhubung
      if (supabaseClient && currentUser && !isGuestMode) {
        try {
          const { error } = await supabaseClient.from('user_settings').upsert({
            user_id: currentUser.id,
            ziswaf_pct: ziswaf,
            investasi_pct: investasi,
            pengeluaran_pct: pengeluaran,
            target_rezeki_tak_terduga: rezeki,
            target_zona_bersyukur: bersyukur,
            updated_at: new Date().toISOString()
          }, { onConflict: 'user_id' });

