    function renderPdf3DChart(pemasukan, items) {
      const maxVal = Math.max(pemasukan, 100000);
      const plotH = 135; // Maximum bar height in px

      let colsHtml = '';
      items.forEach(item => {
        const targetH = Math.max(8, Math.round((item.targetVal / maxVal) * plotH));
        const realisasiH = Math.max(8, Math.round((item.realisasiVal / maxVal) * plotH));

        const tFormatted = item.targetVal >= 1000000 
          ? (item.targetVal / 1000000).toFixed(1).replace('.0', '') + 'jt'
          : Math.round(item.targetVal / 1000) + 'rb';

        const rFormatted = item.realisasiVal >= 1000000 
          ? (item.realisasiVal / 1000000).toFixed(1).replace('.0', '') + 'jt'
          : Math.round(item.realisasiVal / 1000) + 'rb';

        colsHtml += `
          <div class="pdf-zone-col-3d">
            <div class="pdf-bars-pair">
              <!-- 1. Target / Alokasi Bar (Pastel 3D) -->
              <div class="pdf-bar-3d target-${item.colorKey}" style="height: ${targetH}px;">
                <div class="pdf-bar-3d-top"></div>
                <div class="pdf-bar-3d-side"></div>
                <div class="pdf-bar-3d-front"></div>
                <div class="pdf-bar-val-tag">${tFormatted}</div>
              </div>

              <!-- 2. Realisasi Bar (Solid Vibrant 3D) -->
              <div class="pdf-bar-3d realisasi-${item.colorKey}" style="height: ${realisasiH}px;">
                <div class="pdf-bar-3d-top"></div>
                <div class="pdf-bar-3d-side"></div>
                <div class="pdf-bar-3d-front"></div>
                <div class="pdf-bar-3d-gloss"></div>
                <div class="pdf-bar-val-tag realisasi">${rFormatted}</div>
              </div>
            </div>

            <!-- Zone Labels below baseline (Alokasi subtext removed as requested) -->
            <div class="pdf-zone-footer-cell">
              <div class="pdf-zone-title-text">
                <span class="pdf-zone-dot ${item.colorKey}"></span>
                <span>${item.name}</span>
              </div>
              <div class="pdf-zone-pill-status ${item.colorKey}">
                ${item.realisasiPct}% Terealisasi
              </div>
            </div>
          </div>
        `;
      });

      return `
        <div class="pdf-3d-plot-area">
          <div class="pdf-3d-zones-row">
            ${colsHtml}
          </div>
        </div>
        <div class="pdf-3d-floor"></div>
      `;
    }

    function generateSmartAnalysis(
      pemasukan,
      targetZiswafPct, realisasiZiswaf, alokasiZiswaf,
      targetInvestasiPct, realisasiInvestasi, alokasiInvestasi,
      targetPengeluaranPct, realisasiPengeluaran, alokasiPengeluaran,
      sisaKas, sisaPengeluaran, sisaZiswaf, sisaInvestasi
    ) {
      const realisasiZiswafPct = alokasiZiswaf > 0 ? Math.round((realisasiZiswaf / alokasiZiswaf) * 100) : 0;
      const realisasiInvestasiPct = alokasiInvestasi > 0 ? Math.round((realisasiInvestasi / alokasiInvestasi) * 100) : 0;
      const realisasiPengeluaranPct = alokasiPengeluaran > 0 ? Math.round((realisasiPengeluaran / alokasiPengeluaran) * 100) : 0;

      let badgeText = 'SEIMBANG';
      let badgeBg = '#059669'; // Green
      let headline = 'MasyaAllah! Alokasi Kas Keluarga Sangat Sehat & Sesuai Target!';
      const bullets = [];

      const ziswafKurang = realisasiZiswaf < alokasiZiswaf;
      const investasiKurang = realisasiInvestasi < alokasiInvestasi;
      const pengeluaranLebih = realisasiPengeluaran > alokasiPengeluaran || sisaPengeluaran < 0;
      const kasDefisit = sisaKas < 0;

      if (kasDefisit) {
        badgeText = 'PERHATIAN';
        badgeBg = '#DC2626';
        headline = 'Kas Rumah Tangga Mengalami Defisit!';
      } else if (pengeluaranLebih) {
        badgeText = 'EVALUASI';
        badgeBg = '#DC2626';
        headline = 'Porsi Pengeluaran Melampaui Plafon Anggaran!';
      } else if (ziswafKurang || investasiKurang) {
        badgeText = 'EVALUASI';
        badgeBg = '#D97706';
        headline = 'Porsi Investasi atau ZISWAF Belum Mencapai Target Alokasi!';
      }

      // Bullet 1: Ziswaf dengan afirmasi Islami
      if (ziswafKurang) {
        bullets.push(`<strong>Alhamdulillah</strong>, realisasi penyaluran ZISWAF tercatat sebesar <strong>Rp ${formatRupiah(realisasiZiswaf)}</strong> (${realisasiZiswafPct}% dari alokasi Rp ${formatRupiah(alokasiZiswaf)}). Sisihkan segera hak sesama untuk membuka pintu keberkahan kas keluarga Bunda.`);
      } else {
        bullets.push(`<strong>Masya Allah Tabarakallah</strong>, alokasi ZISWAF telah terealisasi optimal sebesar <strong>Rp ${formatRupiah(realisasiZiswaf)}</strong> (${realisasiZiswafPct}% terpenuhi). Semoga menjadi pembersih harta dan pembuka pintu rezeki keluarga.`);
      }

      // Bullet 2: Investasi dengan afirmasi Islami
      if (investasiKurang) {
        bullets.push(`<strong>Alhamdulillah</strong>, realisasi Investasi & Tabungan tercatat <strong>Rp ${formatRupiah(realisasiInvestasi)}</strong> (${realisasiInvestasiPct}% dari alokasi Rp ${formatRupiah(alokasiInvestasi)}). Disiplinkan penabungan sebelum dana terpakai untuk belanja harian.`);
      } else {
        bullets.push(`<strong>Masya Allah</strong>, alokasi Investasi & Tabungan telah tercapai <strong>Rp ${formatRupiah(realisasiInvestasi)}</strong> (${realisasiInvestasiPct}%). Fondasi masa depan keluarga terkelola dengan sangat baik.`);
      }

      // Bullet 3: Pengeluaran dengan afirmasi Islami
      if (sisaPengeluaran < 0) {
        bullets.push(`<strong>Astaghfirullah</strong>, pos Pengeluaran belanja mengalami overbudget sebesar <strong>Rp ${formatRupiah(Math.abs(sisaPengeluaran))}</strong> (${realisasiPengeluaranPct}% dari alokasi Rp ${formatRupiah(alokasiPengeluaran)}). Rem belanja non-primer agar sisa kas tetap terjaga.`);
      } else if (pengeluaranLebih) {
        bullets.push(`Porsi Pengeluaran telah melampaui plafon yaitu <strong>${realisasiPengeluaranPct}%</strong> dari anggaran. Kendalikan belanja konsumtif harian di hari-hari berikutnya.`);
      } else {
        bullets.push(`<strong>Alhamdulillah</strong>, pengeluaran belanja operasional terkendali dengan sisa saldo aman <strong>Rp ${formatRupiah(sisaPengeluaran)}</strong> (${realisasiPengeluaranPct}% terpakai dari pagu Rp ${formatRupiah(alokasiPengeluaran)}). Bunda hebat dan sangat bijak dalam belanja keluarga.`);
      }

      // Bullet 4: Sisa Kas dengan afirmasi Islami
      if (sisaKas > 0) {
        bullets.push(`<strong>Masya Allah Tabarakallah</strong>, sisa kas keluarga tersedia sebesar <strong>Rp ${formatRupiah(sisaKas)}</strong>. Simpan sebagai cadangan dana darurat keluarga demi ketenangan dan kemandirian finansial rumah tangga.`);
      } else if (sisaKas < 0) {
        bullets.push(`<strong>Astaghfirullah</strong>, saldo kas keluarga mengalami defisit minus <strong>Rp ${formatRupiah(Math.abs(sisaKas))}</strong>. Segera evaluasi pos belanja keluarga bulan berjalan.`);
      }

      return { badgeText, badgeBg, headline, bullets };
    }

    /* =========================================================
       J. PENGHITUNGAN LAPORAN EVALUASI & PRATINJAU DOKUMEN (PREVIEW)
       ========================================================= */
    function getEvaluationReportData(targetData = null, targetPeriod = null) {
      if (typeof calculateZones === 'function') {
        calculateZones();
      }
      const data = targetData || currentMonthData || { pemasukan: 0, ziswaf: 0, investasi: 0, pengeluaran: 0 };
      const period = targetPeriod || getSelectedPeriod();
      const [year, month] = period.split('-');
      
      const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
      const monthsShort = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agt", "Sep", "Okt", "Nov", "Des"];
      const monthName = monthNames[parseInt(month, 10) - 1] || month;

      const pemasukan = Number(data.pemasukan) || 0;

      // 1. Logika Perhitungan Alokasi & Yang Terealisasi untuk 4 Zona
      const alokasiPemasukan = pemasukan;
      const alokasiZiswaf = Math.round(pemasukan * (userSettings.ziswaf_pct / 100));
      const alokasiInvestasi = Math.round(pemasukan * (userSettings.investasi_pct / 100));
      const alokasiPengeluaran = Math.round(pemasukan * (userSettings.pengeluaran_pct / 100));

      // Yang Terealisasi
      const spentZiswaf = (targetData && targetData.spent_ziswaf !== undefined)
        ? Number(targetData.spent_ziswaf) || 0
        : (typeof getPoolSpent === 'function' ? getPoolSpent('ziswaf') : 0);
      const spentInvestasi = (targetData && targetData.spent_investasi !== undefined)
        ? Number(targetData.spent_investasi) || 0
        : (typeof getPoolSpent === 'function' ? getPoolSpent('investasi') : 0);
      const spentPengeluaran = (targetData && targetData.spent_pengeluaran !== undefined)
        ? Number(targetData.spent_pengeluaran) || 0
        : (typeof getPoolSpent === 'function' ? getPoolSpent('pengeluaran') : 0);
      const totalSpent = spentZiswaf + spentInvestasi + spentPengeluaran;

      const realisasiPemasukan = pemasukan;
      const realisasiZiswaf = spentZiswaf;
      const realisasiInvestasi = spentInvestasi;
      const realisasiPengeluaran = spentPengeluaran;

      // Persentase Realisasi terhadap Alokasi Pagu
      const realisasiPemasukanPct = 100;
      const realisasiZiswafPct = alokasiZiswaf > 0 ? Math.round((realisasiZiswaf / alokasiZiswaf) * 100) : 0;
      const realisasiInvestasiPct = alokasiInvestasi > 0 ? Math.round((realisasiInvestasi / alokasiInvestasi) * 100) : 0;
      const realisasiPengeluaranPct = alokasiPengeluaran > 0 ? Math.round((realisasiPengeluaran / alokasiPengeluaran) * 100) : 0;

      // Sisa Saldo
      const sisaZiswaf = alokasiZiswaf - realisasiZiswaf;
      const sisaInvestasi = alokasiInvestasi - realisasiInvestasi;
      const sisaPengeluaran = alokasiPengeluaran - realisasiPengeluaran;
      const sisaKas = pemasukan - totalSpent;

      // Metadata Header
      const now = new Date();
      const pad = (n) => (n < 10 ? '0' + n : n);
      const dateStr = `${now.getDate()} ${monthsShort[now.getMonth()]} ${now.getFullYear()}, ${pad(now.getHours())}.${pad(now.getMinutes())}`;
      
      let userName = 'Belum Login';
      if (currentUser) {
        userName = (currentUser.user_metadata && currentUser.user_metadata.full_name) || currentUser.email || 'Bunda';
      } else if (isGuestMode) {
        userName = 'Bunda (Tamu)';
      }

      const chartItems = [
        {
          name: 'Pemasukan',
          colorKey: 'green',
          targetVal: alokasiPemasukan,
          realisasiVal: realisasiPemasukan,
          targetPct: 100,
          realisasiPct: realisasiPemasukanPct
        },
        {
          name: 'ZISWAF',
          colorKey: 'blue',
          targetVal: alokasiZiswaf,
          realisasiVal: realisasiZiswaf,
          targetPct: userSettings.ziswaf_pct,
          realisasiPct: realisasiZiswafPct
        },
        {
          name: 'Investasi',
          colorKey: 'orange',
          targetVal: alokasiInvestasi,
          realisasiVal: realisasiInvestasi,
          targetPct: userSettings.investasi_pct,
          realisasiPct: realisasiInvestasiPct
        },
        {
          name: 'Pengeluaran',
          colorKey: 'red',
          targetVal: alokasiPengeluaran,
          realisasiVal: realisasiPengeluaran,
          targetPct: userSettings.pengeluaran_pct,
          realisasiPct: realisasiPengeluaranPct
        }
      ];

      const ziswafColor = realisasiZiswafPct >= 100 ? '#059669' : '#D97706';
      const investasiColor = realisasiInvestasiPct >= 100 ? '#059669' : '#D97706';
      const pengeluaranColor = realisasiPengeluaranPct <= 100 ? '#059669' : '#DC2626';

      const analysis = generateSmartAnalysis(
        pemasukan,
        userSettings.ziswaf_pct,
        realisasiZiswaf,
        alokasiZiswaf,
        userSettings.investasi_pct,
        realisasiInvestasi,
        alokasiInvestasi,
        userSettings.pengeluaran_pct,
        realisasiPengeluaran,
        alokasiPengeluaran,
        sisaKas,
        sisaPengeluaran,
        sisaZiswaf,
        sisaInvestasi
      );

      return {
        period,
        year,
        month,
        monthName,
        pemasukan,
        alokasiPemasukan,
        alokasiZiswaf,
        alokasiInvestasi,
        alokasiPengeluaran,
        spentZiswaf,
        spentInvestasi,
        spentPengeluaran,
        totalSpent,
        realisasiPemasukan,
        realisasiZiswaf,
        realisasiInvestasi,
        realisasiPengeluaran,
        realisasiPemasukanPct,
        realisasiZiswafPct,
        realisasiInvestasiPct,
        realisasiPengeluaranPct,
        sisaZiswaf,
        sisaInvestasi,
        sisaPengeluaran,
        sisaKas,
        dateStr,
        userName,
        metodeBadge: `${userSettings.ziswaf_pct} / ${userSettings.investasi_pct} / ${userSettings.pengeluaran_pct}`,
        chartTitle: `Grafik Alokasi vs Realisasi Keuangan Bulan ${monthName} ${year}`,
        chartItems,
        ziswafColor,
        investasiColor,
        pengeluaranColor,
        analysis
      };
    }

