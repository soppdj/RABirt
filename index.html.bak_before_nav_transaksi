    function getPoolAllocated(pool) {
      if (!currentMonthData) return 0;
      if (pool === 'pengeluaran') return Number(currentMonthData.pengeluaran) || 0;
      if (pool === 'ziswaf') return Number(currentMonthData.ziswaf) || 0;
      if (pool === 'investasi') return Number(currentMonthData.investasi) || 0;
      return 0;
    }

    function getPoolSpent(pool) {
      if (!Array.isArray(currentMonthExpenses)) return 0;
      return currentMonthExpenses
        .filter(item => item.pool === pool)
        .reduce((sum, item) => sum + (Number(item.amount) || 0), 0);
    }

    function updateModalPoolBalances() {
      const pengeluaranAlloc = getPoolAllocated('pengeluaran');
      const ziswafAlloc = getPoolAllocated('ziswaf');
      const investasiAlloc = getPoolAllocated('investasi');

      const pengeluaranSpent = getPoolSpent('pengeluaran');
      const ziswafSpent = getPoolSpent('ziswaf');
      const investasiSpent = getPoolSpent('investasi');

      const sisaPengeluaran = pengeluaranAlloc - pengeluaranSpent;
      const sisaZiswaf = ziswafAlloc - ziswafSpent;
      const sisaInvestasi = investasiAlloc - investasiSpent;

      // Update Saldo Sisa di 3 Kartu Pilihan Modal
      const elPengeluaran = document.getElementById('poolBalPengeluaran');
      if (elPengeluaran) {
